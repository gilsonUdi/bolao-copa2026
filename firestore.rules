rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Grupos: qualquer pessoa pode ler; só o admin pode atualizar estrutura
    match /grupos/{grupoId} {
      allow read: if true;
      allow create: if true;
      allow update: if true; // Em produção, validar com auth
    }

    // Apostas: qualquer participante pode ler e criar/editar as próprias
    match /apostas/{apostaId} {
      allow read: if true;
      allow write: if true; // Em produção, validar usuário
    }

    // Resultado de jogos: somente leitura para membros
    match /jogos_resultado/{jogoId} {
      allow read: if true;
      allow write: if true; // Em produção, restringir ao admin
    }

    // Índice interno usado pelo painel dev
    match /meta/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
